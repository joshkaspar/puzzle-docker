# Copy to .env and adjust for your host.
# Image tag: <short fork commit>-n<nginx minor>, matching PUZZLE_REF and the
# nginx base in the Dockerfile.
PUZZLE_TAG=e546bf4-n1.30
# Host port and bind address for the web UI.
PUZZLE_PORT=8095
PUZZLE_BIND=0.0.0.0
PUZZLE_CONTAINER_NAME=puzzle
PUZZLE_MEM_LIMIT=128m
